{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "System.Net.Http.HttpClient": "Trace"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "WindowsDev.Api",
    "Audience": "WindowsDev.Client",
    "ExpirationRefreshTokenDays": 30,
    "BytesSizeRefreshToken": 32
  }
}
