<mah:MetroWindow x:Class="WindowsDev.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:dialogs="clr-namespace:MahApps.Metro.Controls.Dialogs;assembly=MahApps.Metro"
                 xmlns:authorizationVm="clr-namespace:WindowsDev.ViewModels.Authorization"
                 xmlns:authorizationView="clr-namespace:WindowsDev.Views.Authorization"
                 xmlns:registrationVm="clr-namespace:WindowsDev.ViewModels.Registration"
                 xmlns:registrationView="clr-namespace:WindowsDev.Views.Registration"
                 xmlns:mainVm="clr-namespace:WindowsDev.ViewModels.Main"
                 xmlns:mainView="clr-namespace:WindowsDev.Views.Main"
                 xmlns:projectVm="clr-namespace:WindowsDev.ViewModels.Project"
                 xmlns:projectView="clr-namespace:WindowsDev.Views.Project"
                 xmlns:taskVm="clr-namespace:WindowsDev.ViewModels.Tasks"
                 xmlns:taskView="clr-namespace:WindowsDev.Views.Tasks"
                 dialogs:DialogParticipation.Register="{Binding CurrentViewModel}"
                 mc:Ignorable="d"
                 Title="TaskManager"
                 Height="450"
                 Width="800"
                 MinWidth="252">

    <!-- Main Grid with View Model Content -->
    <Grid>
        <!-- Content Control for Dynamic View Selection -->
        <ContentControl Content="{Binding CurrentViewModel}">
            <ContentControl.Resources>
                <!-- Data Templates for View Models -->
                <DataTemplate DataType="{x:Type authorizationVm:AuthorizationViewModel}">
                    <authorizationView:AuthorizationView />
                </DataTemplate>

                <DataTemplate DataType="{x:Type registrationVm:RegistrationViewModel}">
                    <registrationView:RegistrationView />
                </DataTemplate>

                <DataTemplate DataType="{x:Type mainVm:MainWindowViewModel}">
                    <mainView:MainView />
                </DataTemplate>

                <DataTemplate DataType="{x:Type projectVm:ProjectViewModel}">
                    <projectView:ProjectView />
                </DataTemplate>

                <DataTemplate DataType="{x:Type taskVm:TaskViewModel}">
                    <taskView:TaskView />
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>
    </Grid>
</mah:MetroWindow>
